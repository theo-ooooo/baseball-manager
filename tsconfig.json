{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ]
    },
    "experimentalDecorators": true
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/shared/src/**/*.ts",
    "infra/**/*.ts",
    "infra/cloudflare/.build/worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/web/dist",
    ".next",
    "apps/web/.next"
  ]
}
