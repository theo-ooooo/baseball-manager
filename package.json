{
  "name": "baseball-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "npm run db:migrate:local && npm run build:api && npm run dev --workspace @dugout/web",
    "build": "bash scripts/build-verified.sh",
    "start": "npm run start --workspace @dugout/web",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "build:api": "node scripts/build-api.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project apps/web/tsconfig.json",
    "test:engine": "node --test tests/game-invariants.test.mjs",
    "test:api": "npm run build && node --test tests/api-database.test.mjs",
    "db:seed:generate": "node scripts/generate-world-seed.mjs",
    "format": "prettier --write \"{apps/web/app,apps/web/src/features,apps/web/src/hooks,apps/web/styles,apps/api/src,apps/api/db,packages/shared/src,infra,scripts,tests}/**/*.{ts,tsx,mjs,css}\" \"apps/web/src/components/{game-ui,club-badge}.tsx\"",
    "format:check": "prettier --check \"{apps/web/app,apps/web/src/features,apps/web/src/hooks,apps/web/styles,apps/api/src,apps/api/db,packages/shared/src,infra,scripts,tests}/**/*.{ts,tsx,mjs,css}\" \"apps/web/src/components/{game-ui,club-badge}.tsx\"",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
